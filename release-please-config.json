        },
        {
          "type": "json",
          "path": "/.claude-plugin/marketplace.json",
          "jsonpath": "$.plugins[?(@.name=='headroom-hud')].version"
        }
      ]
    },
    "laya-router": {
      "component": "laya-router",
      "extra-files": [
        {
          "type": "json",
